# Local development only. `make up` copies this to .env on first run.
# Never reuse these values outside a laptop. Compose refuses to start if any is missing.
COMPOSE_PROJECT_NAME=sijil
SIJIL_REGION=ma-cas

POSTGRES_PASSWORD=dev-postgres-change-me
SIJIL_CP_OWNER_DB_PASSWORD=dev-cp-owner-change-me
SIJIL_CP_APP_DB_PASSWORD=dev-cp-app-change-me
SIJIL_PROVISIONER_DB_PASSWORD=dev-provisioner-change-me

# RustFS root key: only `migrate` (and the test runner) hold it.
OBJECTSTORE_ACCESS_KEY=sijil-dev
OBJECTSTORE_SECRET_KEY=dev-objectstore-change-me
# What every running service uses: put/read/list only, never delete or bypass a lock.
# `migrate` creates this user with the root key (`sijil-cp bootstrap-storage`).
SIJIL_OBJECTSTORE_APP_ACCESS_KEY=sijil-app
SIJIL_OBJECTSTORE_APP_SECRET_KEY=dev-objectstore-app-change-me
# The seal worker's key: reads and sets retention (COMPLIANCE after a seal), nothing
# else: no object bytes, no delete. `migrate` creates it too; only `worker-seal` holds it.
SIJIL_OBJECTSTORE_SEAL_ACCESS_KEY=sijil-seal
SIJIL_OBJECTSTORE_SEAL_SECRET_KEY=dev-objectstore-seal-change-me
# The removal worker's key: deletes a version (an unsealed original, or one whose lock has
# expired) and reads its lock, nothing else: no object bytes, no retention change. `migrate`
# creates it too; only `worker-removal` holds it.
SIJIL_OBJECTSTORE_REMOVAL_ACCESS_KEY=sijil-removal
SIJIL_OBJECTSTORE_REMOVAL_SECRET_KEY=dev-objectstore-removal-change-me
# The export worker's key: reads originals and puts, reads and deletes the built exports (the
# `-exports` bucket), nothing else. `migrate` creates it too; only `worker-export` holds it.
SIJIL_OBJECTSTORE_EXPORT_ACCESS_KEY=sijil-export
SIJIL_OBJECTSTORE_EXPORT_SECRET_KEY=dev-objectstore-export-change-me

# The region's Ed25519 export key pair, base64 of the raw 32 bytes each. Left empty here:
# `make up` (infra/scripts/ensure-signing-key.sh) generates a pair into .env once and never
# overwrites one. Only `worker-export` holds the signing seed; the control plane the public key.
SIJIL_EXPORT_SIGNING_KEY=
SIJIL_EXPORT_PUBLIC_KEY=

# Sample tenants (seeded from fixtures/). Real tenants are provisioned by the worker.
# *_DB_PASSWORD goes to that tenant's Paperless-ngx; *_INDEX_DB_PASSWORD never does.
T1_DB_PASSWORD=dev-t1-db-change-me
T1_INDEX_DB_PASSWORD=dev-t1-index-change-me
T1_SECRET_KEY=dev-t1-secret-key-change-me-0000000000000000
T1_ADMIN_PASSWORD=dev-t1-admin-change-me
T2_DB_PASSWORD=dev-t2-db-change-me
T2_INDEX_DB_PASSWORD=dev-t2-index-change-me
T2_SECRET_KEY=dev-t2-secret-key-change-me-0000000000000000
T2_ADMIN_PASSWORD=dev-t2-admin-change-me

# Extraction model: pulled by `make models` (the only service with internet access does the
# pull) and used by the worker. qwen3:4b fits a laptop's Docker with two Paperless tenants.
SIJIL_EXTRACTION_MODEL=qwen3:4b

# Regional master key (base64 of 32 random bytes). Dev only: generate a fresh one per region
# with `openssl rand -base64 32` and keep it out of git.
SIJIL_MASTER_KEY=G/YLcmBqhInPssn2o4EL7+KXuVkNLvc8HwaMQxb6iMs=
