# Test runner. Tenant networks are internal (no published ports), so integration tests must run
# inside them. Build context: repository root. The repo is mounted over /src at run time; the
# virtualenv lives in /opt/venv so it never clashes with the host's .venv.
FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.3 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH"
WORKDIR /src

COPY pyproject.toml uv.lock ./
COPY libs ./libs
COPY services ./services
RUN uv sync --frozen --all-packages

CMD ["uv", "run", "--frozen", "pytest", "-m", "integration"]
